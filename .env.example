# Neon connection string (pooled). https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Which model the agent runs on. Swap the provider, keep the code.
#   google | anthropic | openai | xai
AI_PROVIDER="google"
# Optional: override the provider's default model id.
# AI_MODEL="gemini-3.6-flash"

GOOGLE_GENERATIVE_AI_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# XAI_API_KEY=""

# Shared secret protecting the agent endpoint from the open internet.
AGENT_SECRET="change-me"

# Optional but recommended in production: with a QStash token the trigger goes
# through a real queue, so a run killed by a function timeout is retried instead
# of silently vanishing. All three values come from the Upstash console.
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""

# Optional: set in production so the app can address its own agent endpoint.
# APP_URL="https://your-app.vercel.app"
